# Core API settings remain optional for local mock development.

# Phase 4 Milvus Standalone. Production never falls back to the test backend.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=finance_agent_chunks_v1
MILVUS_INDEX_VERSION=finance-chunks-v1

# BAAI/bge-large-zh-v1.5 is loaded lazily only when dense retrieval is enabled.
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_REVISION=79e7739b6ab944e86d6171e44d24c997fc1e0116
