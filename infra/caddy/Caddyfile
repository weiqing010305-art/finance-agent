{
    auto_https disable_redirects
}

https://localhost {
    tls internal
    encode zstd gzip
    request_body {
        max_size 25MB
    }
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; connect-src 'self' https://localhost:9443; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://localhost:9443; frame-ancestors 'none'"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

https://localhost:9443 {
    tls internal
    header -Server
    reverse_proxy minio:9000
}
